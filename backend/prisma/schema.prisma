generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String         @map("password_hash")
  role         String         @default("student") // 'student', 'driver', 'admin'
  fcmToken     String?        @map("fcm_token")
  createdAt    DateTime       @default(now()) @map("created_at")
  
  RefreshTokens RefreshToken[]
  Trips        Trip[]
  Buses        Bus[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Bus {
  id             String  @id // e.g., "bus1"
  registrationNo String? @map("registration_no")
  model          String?
  capacity       Int?
  driverId       String? @map("driver_id")
  isActive       Boolean @default(true) @map("is_active")
  
  driver         User?   @relation(fields: [driverId], references: [id])
  Routes         Route[]
  Trips          Trip[]

  @@map("buses")
}

model Route {
  id          String  @id // e.g., "route-1"
  name        String
  shortName   String? @map("short_name")
  description String?
  busId       String? @map("bus_id")
  pin         String? // hashed pin for driver access fallback
  color       String?
  isActive    Boolean @default(true) @map("is_active")
  
  bus         Bus?    @relation(fields: [busId], references: [id])
  Stops       Stop[]
  Trips       Trip[]

  @@map("routes")
}

model Stop {
  id           String @id @default(uuid())
  routeId      String @map("route_id")
  name         String
  lat          Float
  lng          Float
  stopOrder    Int    @map("stop_order")
  radiusMeters Int    @default(100) @map("radius_meters")
  
  route        Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, stopOrder])
  @@map("stops")
}

model Trip {
  id            String         @id @default(uuid())
  routeId       String         @map("route_id")
  busId         String         @map("bus_id")
  driverId      String?        @map("driver_id")
  status        String         // "active", "completed", "cancelled"
  startedAt     DateTime       @default(now()) @map("started_at")
  endedAt       DateTime?      @map("ended_at")
  
  route         Route          @relation(fields: [routeId], references: [id])
  bus           Bus            @relation(fields: [busId], references: [id])
  driver        User?          @relation(fields: [driverId], references: [id])
  LiveLocations LiveLocation[]

  @@index([routeId, status])
  @@map("trips")
}

model LiveLocation {
  id         BigInt   @id @default(autoincrement())
  tripId     String   @map("trip_id")
  lat        Float
  lng        Float
  speed      Float?
  heading    Float?
  accuracy   Float?
  recordedAt DateTime @default(now()) @map("recorded_at")
  
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt(sort: Desc)])
  @@map("live_locations")
}

model Notification {
  id      String    @id @default(uuid())
  userId  String    @map("user_id")
  tripId  String?   @map("trip_id")
  type    String
  title   String
  body    String
  sentAt  DateTime  @default(now()) @map("sent_at")
  readAt  DateTime? @map("read_at")

  @@map("notifications")
}
